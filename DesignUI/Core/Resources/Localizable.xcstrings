        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पसंदीदा को सहेजने, उपकरणों के बीच समन्वयित करने और विशेष सुविधाओं तक पहुँचने के लिए अपना खाता बनाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stvorite svoj račun za spremanje favorita, sinkronizaciju između uređaja i pristup ekskluzivnim značajkama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
