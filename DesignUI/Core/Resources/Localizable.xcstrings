    "Create your account to save favorites,\nsync across devices, and access\nexclusive features." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشئ حسابك لحفظ مفضلاتك، ومزامنتها عبر الأجهزة، والوصول إلى ميزات حصرية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea el teu compte per desar els preferits,\nsincronitzar entre dispositius i accedir a\nfuncions exclusives."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvořte si účet pro ukládání oblíbených položek, synchronizaci mezi zařízeními a přístup k exkluzivním funkcím."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opret din konto for at gemme favoritter, synkronisere på tværs af enheder og få adgang til eksklusive funktioner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellen Sie Ihr Konto, um Favoriten zu speichern,\nGeräteübergreifend zu synchronisieren und auf\nexklusive Funktionen zuzugreifen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
