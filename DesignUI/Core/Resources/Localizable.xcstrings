        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಉಚಿತ ಬಳಕೆದಾರರು %lld ಡಿಸೈನ್ಗಳಿಗೆ ಮಿತಿಯಲ್ಲಿದ್ದಾರೆ. ನಿರಂತರ ಡಿಸೈನ್ಗಳನ್ನು ರಚಿಸಲು ಚಂದಾದಾರರಾಗಿರಿ."
