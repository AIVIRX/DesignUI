        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea tu cuenta para guardar favoritos, sincronizar entre dispositivos y acceder a funciones exclusivas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luo tili tallentaaksesi suosikit, synkronoidaksesi laitteiden välillä ja päästäksesi käsiksi eksklusiivisiin ominaisuuksiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez votre compte pour enregistrer des favoris, synchroniser sur plusieurs appareils et accéder à des fonctionnalités exclusives."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez votre compte pour enregistrer des favoris, synchroniser entre les appareils et accéder à des fonctionnalités exclusives."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ફેવરિટ્સ સાચવવા, ડિવાઇસમાં સમન્વય કરવા અને વિશિષ્ટ સુવિધાઓનો ઉપયોગ કરવા માટે તમારું ખાતું બનાવો."
