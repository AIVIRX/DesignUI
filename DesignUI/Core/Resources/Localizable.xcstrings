          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luo tili tallentaaksesi suosikkeja,\nsynkronoi laitteiden välillä ja käytä\nyksinoikeudella saatavia ominaisuuksia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez votre compte pour enregistrer vos favoris,\nsynchroniser vos données sur tous vos appareils et accéder à des fonctionnalités exclusives."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez votre compte pour enregistrer vos signets,\nsynchroniser vos données sur tous vos appareils et accéder à des fonctionnalités exclusives."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צור את החשבון שלך כדי לשמור מועדפים,\nלסנכרן בין מכשירים ולגשת לתכונות בלעדיות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पसंदीदा को सहेजने,\nसभी डिवाइसों में सिंक करने और\nविशेष सुविधाओं तक पहुँचने के लिए अपना खाता बनाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izradite svoj račun za spremanje favorita,\nsinkroniziranje na različitim uređajima i pristup\nekskluzivnim značajkama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hozz létre fiókot a kedvencek mentéséhez,\neszközök közötti szinkronizáláshoz és\nexkluzív funkciók eléréséhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buat akun Anda untuk menyimpan favorit,\nsinkronisasi antar perangkat, dan akses\nfitur eksklusif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea il tuo account per salvare i preferiti,\nsincronizzare su più dispositivi e accedere\na funzionalità esclusive."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントを作成すると、お気に入りの保存、デバイス間の同期、限定機能へのアクセスが\n可能になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정을 생성하여 즐겨찾기를 저장하고, 여러 기기에서 동기화하고, 독점 기능을 이용하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buat akaun anda untuk menyimpan kegemaran,\npenyegerakan merentas peranti dan akses\nciri eksklusif."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opprett kontoen din for å lagre favoritter, synkronisere på tvers av enheter og få tilgang til eksklusive funksjoner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak een account aan om favorieten op te slaan,\nte synchroniseren tussen apparaten en toegang te krijgen tot\nexclusieve functies."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utwórz konto, aby zapisywać ulubione,\nsynchronizować się między urządzeniami i uzyskiwać dostęp\ndo ekskluzywnych funkcji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crie sua conta para salvar favoritos,\nsincronizar entre dispositivos e acessar\nrecursos exclusivos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crie a sua conta para guardar favoritos,\nsincronizar entre dispositivos e aceder\nrecursos exclusivos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creează-ți contul pentru a salva favoritele,\na sincroniza pe dispozitive și a accesa\nfuncții exclusive."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создайте свою учетную запись, чтобы сохранять избранное,\nсинхронизировать между устройствами и получать доступ к\nэксклюзивным функциям."
          }
        },
        "sk" : {
          "stringUnit" : {
