    "Free users are limited to %lld designs. Subscribe to create unlimited designs." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقتصر عدد التصاميم المتاحة للمستخدمين المجانيين على 10 تصاميم. اشترك الآن لإنشاء عدد غير محدود من التصاميم."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els usuaris gratuïts estan limitats a %lld dissenys. Subscriu-te per crear dissenys il·limitats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uživatelé bezplatné verze mají omezený počet návrhů (%lld). Přihlaste se k odběru a vytvářejte neomezený počet návrhů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratisbrugere er begrænset til %lld designs. Abonner for at skabe et ubegrænset antal designs."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kostenlose Nutzer sind auf %lld Designs beschränkt. Abonnieren Sie, um unbegrenzt Designs zu erstellen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι δωρεάν χρήστες περιορίζονται σε %lld σχέδια. Εγγραφείτε για να δημιουργήσετε απεριόριστα σχέδια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Free users are limited to %lld designs. Subscribe to create unlimited designs."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free users are limited to %lld designs. Subscribe to create unlimited designs."
          }
