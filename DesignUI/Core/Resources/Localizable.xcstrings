    "Are you sure you want to delete this design? This action cannot be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل أنت متأكد من رغبتك في حذف هذا التصميم؟ لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esteu segur que voleu suprimir aquest disseny? Aquesta acció no es pot desfer."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jste si jisti, že chcete tento návrh smazat? Tuto akci nelze vrátit zpět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du sikker på, at du vil slette dette design? Denne handling kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sind Sie sicher, dass Sie dieses Design löschen möchten? Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Είστε βέβαιοι ότι θέλετε να διαγράψετε αυτό το σχέδιο; Αυτή η ενέργεια δεν μπορεί να αναιρεθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Are you sure you want to delete this design? This action cannot be undone."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to delete this design? This action cannot be undone."
          }
        },
