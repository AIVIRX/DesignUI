        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفت صارفین کو %lld ڈیزائنز تک محدود کیا گیا ہے۔ لامحدود ڈیزائن بنانے کے لیے سبسکرائب کریں۔"
