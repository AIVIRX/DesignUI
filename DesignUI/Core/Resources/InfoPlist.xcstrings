          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для сохранения скриншотов в вашу фототеку DockUI требуется разрешение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI potrebuje povolenie na ukladanie snímok obrazovky do vašej knižnice fotografií."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI potrebuje dovoljenje za shranjevanje posnetkov zaslona v vašo knjižnico fotografij."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI behöver behörighet för att spara skärmdumpar i ditt fotobibliotek."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI ต้องการสิทธิ์ในการบันทึกภาพหน้าจอลงในคลังภาพของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI'nin ekran görüntülerini fotoğraf kitaplığınıza kaydetmesi için izne ihtiyacı var."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI потрібен дозвіл на збереження скріншотів у вашій фотобібліотеці."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI cần quyền lưu ảnh chụp màn hình vào thư viện ảnh của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI需要获得权限才能将屏幕截图保存到您的照片库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
