          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI tarvitsee luvan tallentaakseen kuvakaappauksia valokuvakirjastoosi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI a besoin de l'autorisation d'enregistrer des captures d'écran dans votre bibliothèque de photos."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI a besoin de la permission d'enregistrer des captures d'écran dans votre bibliothèque de photos."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI זקוק להרשאה כדי לשמור צילומי מסך בספריית התמונות שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI को स्क्रीनशॉट को आपकी फोटो लाइब्रेरी में सेव करने की अनुमति चाहिए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI treba dopuštenje za spremanje snimaka zaslona u vašu biblioteku fotografija."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A DockUI-nak engedélyre van szüksége a képernyőképek mentéséhez a fotókönyvtárba."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
