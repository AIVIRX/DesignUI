    "DockUI Design" : {

    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج DockUI إلى إذن لحفظ لقطات الشاشة في مكتبة الصور الخاصة بك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI necessita permís per desar captures de pantalla a la teva biblioteca de fotos."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI potřebuje oprávnění k ukládání snímků obrazovky do vaší knihovny fotografií."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI skal bruge tilladelse til at gemme skærmbilleder i dit fotobibliotek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI benötigt die Berechtigung, Screenshots in Ihrer Fotobibliothek zu speichern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το DockUI χρειάζεται άδεια για να αποθηκεύσει στιγμιότυπα οθόνης στη βιβλιοθήκη φωτογραφιών σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockUI needs permission to save screenshots to your photo library."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI needs permission to save screenshots to your photo library."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI needs permission to save screenshots to your photo library."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI needs permission to save screenshots to your photo library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI necesita permiso para guardar capturas de pantalla en su biblioteca de fotos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
