    "NSUserTrackingUsageDescription" : {
      "comment" : "Privacy - Tracking Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سوف نستخدم نشاطك لتقديم الإعلانات ذات الصلة لك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilitzarem la vostra activitat per oferir-vos anuncis rellevants."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaši aktivitu použijeme k zobrazování relevantních reklam."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi vil bruge din aktivitet til at levere relevante annoncer til dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir nutzen Ihre Aktivitäten, um Ihnen relevante Werbung zu liefern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα χρησιμοποιήσουμε τη δραστηριότητά σας για να σας παρέχουμε σχετικές διαφημίσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This identifier will be used  o show personlized ads "
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We will use your activity to deliver relevant ads to you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We will use your activity to deliver relevant ads to you."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We will use your activity to deliver relevant ads to you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilizaremos su actividad para ofrecerle anuncios relevantes."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilizaremos su actividad para ofrecerle anuncios relevantes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytämme toimintaasi asianmukaisten mainosten näyttämiseen sinulle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous utiliserons votre activité pour vous proposer des publicités pertinentes."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous utiliserons votre activité pour vous proposer des publicités pertinentes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אנו נשתמש בפעילות שלך כדי להציג לך מודעות רלוונטיות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हम आपकी गतिविधि का उपयोग आपको प्रासंगिक विज्ञापन देने के लिए करेंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iskoristit ćemo vašu aktivnost kako bismo vam isporučili relevantne oglase."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tevékenységét arra fogjuk felhasználni, hogy releváns hirdetéseket jelenítsünk meg Önnek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami akan menggunakan aktivitas Anda untuk menayangkan iklan yang relevan kepada Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilizzeremo la tua attività per fornirti annunci pertinenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたのアクティビティを利用して、関連性の高い広告を配信します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당사는 귀하의 활동을 활용하여 귀하에게 관련성 높은 광고를 제공할 것입니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami akan menggunakan aktiviti anda untuk menyampaikan iklan yang berkaitan kepada anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi vil bruke aktiviteten din til å levere relevante annonser til deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
