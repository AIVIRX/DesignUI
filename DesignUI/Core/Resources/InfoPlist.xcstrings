    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج DockUI إلى إذن لحفظ لقطات الشاشة في مكتبة الصور الخاصة بك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI necessita permís per desar captures de pantalla a la teva biblioteca de fotos."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI potřebuje oprávnění k ukládání snímků obrazovky do vaší knihovny fotografií."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI skal bruge tilladelse til at gemme skærmbilleder i dit fotobibliotek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI benötigt die Berechtigung, Screenshots in Ihrer Fotobibliothek zu speichern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το DockUI χρειάζεται άδεια για να αποθηκεύσει στιγμιότυπα οθόνης στη βιβλιοθήκη φωτογραφιών σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockUI needs permission to save screenshots to your photo library."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI needs permission to save screenshots to your photo library."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI needs permission to save screenshots to your photo library."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI needs permission to save screenshots to your photo library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI necesita permiso para guardar capturas de pantalla en su biblioteca de fotos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI necesita permiso para guardar capturas de pantalla en su biblioteca de fotos."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI necesita permiso para guardar capturas de pantalla en su biblioteca de fotos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI tarvitsee luvan tallentaakseen kuvakaappauksia valokuvakirjastoosi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI a besoin de l'autorisation d'enregistrer des captures d'écran dans votre bibliothèque de photos."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI a besoin de la permission d'enregistrer des captures d'écran dans votre bibliothèque de photos."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI זקוק להרשאה כדי לשמור צילומי מסך בספריית התמונות שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI को स्क्रीनशॉट को आपकी फोटो लाइब्रेरी में सेव करने की अनुमति चाहिए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI treba dopuštenje za spremanje snimaka zaslona u vašu biblioteku fotografija."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A DockUI-nak engedélyre van szüksége a képernyőképek mentéséhez a fotókönyvtárba."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI memerlukan izin untuk menyimpan tangkapan layar ke perpustakaan foto Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI necessita dell'autorizzazione per salvare gli screenshot nella libreria fotografica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI には、スクリーンショットを写真ライブラリに保存する権限が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI는 스크린샷을 사진 보관함에 저장하기 위한 권한이 필요합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI memerlukan kebenaran untuk menyimpan tangkapan skrin ke pustaka foto anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI trenger tillatelse til å lagre skjermbilder i bildebiblioteket ditt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI heeft toestemming nodig om schermafbeeldingen in je fotobibliotheek op te slaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockUI potrzebuje pozwolenia na zapisywanie zrzutów ekranu w bibliotece zdjęć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O DockUI precisa de permissão para salvar capturas de tela na sua biblioteca de fotos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
