    "NSUserTrackingUsageDescription" : {
      "comment" : "Privacy - Tracking Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم استخدام هذا المعرف لعرض إعلانات مخصصة لك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest identificador s'utilitzarà per mostrar-vos anuncis personalitzats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento identifikátor bude použit k zobrazování personalizovaných reklam."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne identifikator vil blive brugt til at levere personligt tilpassede annoncer til dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Kennung wird verwendet, um Ihnen personalisierte Werbung anzuzeigen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το αναγνωριστικό θα χρησιμοποιηθεί για την προβολή εξατομικευμένων διαφημίσεων σε εσάς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This identifier will be used to deliver personalized ads to you."
          }
        },
        "en-AU" : {
          "stringUnit" : {
