    "Dock UI uses Sign in with Apple. Your email address is never shared without your permission." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "value" : "Dock UI sử dụng Đăng nhập bằng Apple. Địa chỉ email của bạn không bao giờ được chia sẻ mà không có sự cho phép của bạn.",
            "state" : "translated"
          }
        },
        "bn" : {
          "stringUnit" : {
            "value" : "ডক ইউআই অ্যাপল দিয়ে সাইন ইন ব্যবহার করে। আপনার ইমেল ঠিকানা কখনও আপনার অনুমতি ছাড়া শেয়ার করা হয় না।",
            "state" : "translated"
          }
        },
        "ml" : {
          "stringUnit" : {
            "value" : "Dock UI Apple सह साइन इन वापरतो. तुमचा ईमेल पत्ता तुमच्या परवानगीशिवाय कधीही सामायिक केला जात नाही.",
            "state" : "translated"
          }
        },
        "id" : {
          "stringUnit" : {
            "value" : "Dock UI menggunakan Masuk dengan Apple. Alamat email Anda tidak akan dibagikan tanpa izin Anda.",
            "state" : "translated"
          }
        },
        "ms" : {
          "stringUnit" : {
            "value" : "Dock UI menggunakan Daftar Masuk dengan Apple. Alamat emel anda tidak akan dikongsi tanpa kebenaran anda.",
            "state" : "translated"
