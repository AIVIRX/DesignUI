    "Keep your work, preferences, and saved designs available wherever you use Dock UI." : {
      "localizations" : {
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने काम, प्राथमिकताएँ, और सहेजे गए डिज़ाइन को Dock UI का उपयोग करते समय कहीं भी उपलब्ध रखें।"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold arbeidet ditt, innstillinger og lagrede design tilgjengelig uansett hvor du bruker Dock UI."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock UIを使用する場所で、作業、設定、および保存されたデザインを利用できるようにします。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalışmalarınızı, tercihlerinizi ve kaydedilmiş tasarımlarınızı Dock UI'yi kullandığınız her yerde erişilebilir tutun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez votre travail, vos préférences et vos conceptions enregistrées disponibles où que vous utilisiez Dock UI."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ ಕೆಲಸ, ಆಯ್ಕೆಗಳು ಮತ್ತು ಉಳಿಸಿದ ವಿನ್ಯಾಸಗಳನ್ನು ಡಾಕ್ ಯುಐ ಬಳಸುವ ಎಲ್ಲೆಡೆ ಲಭ್ಯವಿರುತ್ತವೆ."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantingues la teva feina, preferències i dissenys desats disponibles a qualsevol lloc on utilitzis Dock UI."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ ജോലി, മുൻഗണനകൾ, സേവ് ചെയ്ത ഡിസൈനുകൾ ഡോക്ക് UI ഉപയോഗിക്കുന്ന എല്ലാ സ്ഥലങ്ങളിലും ലഭ്യമാക്കുക."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Išlaikykite savo darbą, nustatymus ir išsaugotus dizainus prieinamus bet kur, kur naudojate Dock UI."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमचे काम, प्राधान्ये, आणि जतन केलेले डिझाइन Dock UI वर कुठेही उपलब्ध राहतील."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার কাজ, পছন্দ এবং সংরক্ষিত ডিজাইনগুলি যেখানে আপনি ডক ইউআই ব্যবহার করেন সেখানে উপলব্ধ থাকবে।"
