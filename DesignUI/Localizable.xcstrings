    "Free users are limited to %lld designs. Subscribe to create unlimited designs." : {
      "localizations" : {
        "es-US" : {
          "stringUnit" : {
            "value" : "Los usuarios gratuitos están limitados a %lld diseños. Suscríbete para crear diseños ilimitados.",
            "state" : "translated"
          }
        },
        "nb" : {
          "stringUnit" : {
            "value" : "Gratisbrukere er begrenset til %lld design. Abonner for å lage ubegrensede design.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "無料ユーザーは %lld デザインに制限されています。無制限のデザインを作成するには、購読してください。",
            "state" : "translated"
          }
        },
        "tr" : {
          "stringUnit" : {
            "value" : "Ücretsiz kullanıcılar %lld tasarımla sınırlıdır. Sınırsız tasarım oluşturmak için abone olun.",
            "state" : "translated"
          }
        },
        "kn" : {
          "stringUnit" : {
            "value" : "ಮುಕ್ತ ಬಳಕೆದಾರರು %lld ವಿನ್ಯಾಸಗಳಿಗೆ ಮಿತಿಯಲ್ಲಿದ್ದಾರೆ. ನಿರಂತರ ವಿನ್ಯಾಸಗಳನ್ನು ರಚಿಸಲು ಚಂದಾದಾರರಾಗಿರಿ.",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Les utilisateurs gratuits sont limités à %lld designs. Abonnez-vous pour créer des designs illimités.",
            "state" : "translated"
          }
        },
        "ca" : {
          "stringUnit" : {
            "value" : "Els usuaris gratuïts estan limitats a %lld dissenys. Subscriu-te per crear dissenys il·limitats.",
            "state" : "translated"
          }
        },
        "ml" : {
          "stringUnit" : {
            "value" : "മുക്ത ഉപയോക്താക്കൾക്ക് %lld ഡിസൈനുകൾക്ക് പരിമിതമാണ്. അനന്തമായ ഡിസൈനുകൾ സൃഷ്ടിക്കാൻ സബ്സ്ക്രൈബ് ചെയ്യുക.",
            "state" : "translated"
          }
        },
        "lt" : {
          "stringUnit" : {
            "value" : "Nemokami vartotojai gali sukurti tik %lld dizainų. Prenumeruokite, kad sukurtumėte neribotą dizainų skaičių.",
            "state" : "translated"
          }
        },
        "mr" : {
          "stringUnit" : {
            "value" : "मोफत वापरकर्त्यांना %lld डिझाइनपर्यंत मर्यादित आहे. अमर्यादित डिझाइन तयार करण्यासाठी सदस्यता घ्या.",
            "state" : "translated"
          }
        },
        "bn" : {
          "stringUnit" : {
            "value" : "মুক্ত ব্যবহারকারীরা %lld ডিজাইনে সীমাবদ্ধ। অসীম ডিজাইন তৈরি করতে সাবস্ক্রাইব করুন।",
            "state" : "translated"
          }
        },
        "fi" : {
          "stringUnit" : {
            "value" : "Ilmaisilla käyttäjillä on rajoitettu %lld mallia. Tilaa luodaksesi rajattomasti malleja.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Kostenlose Benutzer sind auf %lld Designs beschränkt. Abonnieren Sie, um unbegrenzt Designs zu erstellen.",
            "state" : "translated"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "value" : "Los usuarios gratuitos están limitados a %lld diseños. Suscríbete para crear diseños ilimitados.",
            "state" : "translated"
          }
        },
        "ta" : {
          "stringUnit" : {
            "value" : "Οι δωρεάν χρήστες περιορίζονται σε %lld σχέδια. Εγγραφείτε για να δημιουργήσετε απεριόριστα σχέδια.",
            "state" : "translated"
          }
        },
        "vi" : {
          "stringUnit" : {
            "value" : "Người dùng miễn phí bị giới hạn ở %lld thiết kế. Đăng ký để tạo thiết kế không giới hạn.",
            "state" : "translated"
          }
        },
        "uk" : {
          "stringUnit" : {
            "value" : "Безкоштовні користувачі обмежені до %lld дизайнів. Підпишіться, щоб створювати необмежену кількість дизайнів.",
            "state" : "translated"
          }
        },
        "ro" : {
          "stringUnit" : {
            "value" : "Utilizatorii gratuiti sunt limitați la %lld designuri. Abonați-vă pentru a crea designuri nelimitate.",
            "state" : "translated"
          }
