        },
        "gu" : {
          "stringUnit" : {
            "value" : "મફત વપરાશકર્તાઓને %lld ડિઝાઇન સુધી મર્યાદિત છે. અનલિમિટેડ ડિઝાઇન બનાવવા માટે સબ્સ્ક્રાઇબ કરો.",
