    "Free users are limited to %lld designs. Subscribe to create unlimited designs." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "value" : "Người dùng miễn phí bị giới hạn ở %lld thiết kế. Đăng ký để tạo thiết kế không giới hạn.",
            "state" : "translated"
          }
        },
        "bn" : {
          "stringUnit" : {
            "value" : "মুক্ত ব্যবহারকারীরা %lld ডিজাইনে সীমাবদ্ধ। অসীম ডিজাইন তৈরি করতে সাবস্ক্রাইব করুন।",
            "state" : "translated"
          }
        },
        "id" : {
          "stringUnit" : {
            "value" : "Pengguna gratis dibatasi hingga %lld desain. Berlangganan untuk membuat desain tanpa batas.",
            "state" : "translated"
          }
        },
        "ml" : {
          "stringUnit" : {
            "value" : "മുക്ത ഉപയോക്താക്കൾക്ക് %lld ഡിസൈനുകൾക്ക് പരിമിതമാണ്. അനന്തമായ ഡിസൈനുകൾ സൃഷ്ടിക്കാൻ സബ്സ്ക്രൈബ് ചെയ്യുക.",
            "state" : "translated"
          }
        },
        "ms" : {
          "stringUnit" : {
            "value" : "Pengguna percuma terhad kepada %lld reka bentuk. Langgan untuk mencipta reka bentuk tanpa had.",
            "state" : "translated"
          }
        },
        "sk" : {
          "stringUnit" : {
            "value" : "Bezplatní používatelia sú obmedzení na %lld dizajnov. Predplaťte si, aby ste mohli vytvárať neobmedzené dizajny.",
            "state" : "translated"
          }
        },
        "es-US" : {
          "stringUnit" : {
            "value" : "Los usuarios gratuitos están limitados a %lld diseños. Suscríbete para crear diseños ilimitados.",
            "state" : "translated"
          }
        },
        "kk" : {
          "stringUnit" : {
            "value" : "Тегін пайдаланушылар %lld дизайнмен шектелген. Шексіз дизайн жасау үшін жазылыңыз.",
            "state" : "translated"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "Os utilizadores gratuitos estão limitados a %lld designs. Subscreva para criar designs ilimitados.",
            "state" : "translated"
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "value" : "Free users are limited to %lld designs. Subscribe to create unlimited designs.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Gratisanvändare är begränsade till %lld designer. Prenumerera för att skapa obegränsade designer.",
            "state" : "translated"
          }
        },
        "pa" : {
          "stringUnit" : {
            "value" : "ਮੁਫਤ ਉਪਭੋਗਤਾਵਾਂ ਨੂੰ %lld ਡਿਜ਼ਾਈਨਾਂ ਤੱਕ ਸੀਮਿਤ ਕੀਤਾ ਗਿਆ ਹੈ। ਅਨੰਤ ਡਿਜ਼ਾਈਨ ਬਣਾਉਣ ਲਈ ਸਬਸਕ੍ਰਾਈਬ ਕਰੋ।",
            "state" : "translated"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "value" : "Free users are limited to %lld designs. Subscribe to create unlimited designs.",
            "state" : "translated"
          }
        },
        "kn" : {
          "stringUnit" : {
            "value" : "ಮುಕ್ತ ಬಳಕೆದಾರರು %lld ವಿನ್ಯಾಸಗಳಿಗೆ ಮಿತಿಯಲ್ಲಿದ್ದಾರೆ. ನಿರಂತರ ವಿನ್ಯಾಸಗಳನ್ನು ರಚಿಸಲು ಚಂದಾದಾರರಾಗಿರಿ.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "無料ユーザーは %lld デザインに制限されています。無制限のデザインを作成するには、購読してください。",
