    "Are you sure you want to delete this design? This action cannot be undone." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estàs segur que vols eliminar aquest disseny? Aquesta acció no es pot desfer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы уверены, что хотите удалить этот дизайн? Это действие нельзя отменить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ste si istí, že chcete odstrániť tento dizajn? Túto akciu nie je možné vrátiť späť."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to delete this design? This action cannot be undone."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האם אתה בטוח שברצונך למחוק את העיצוב הזה? פעולה זו אינה ניתנת לביטול."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 디자인을 삭제하시겠습니까? 이 작업은 취소할 수 없습니다."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Êtes-vous sûr de vouloir supprimer ce design ? Cette action ne peut pas être annulée."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali ste prepričani, da želite izbrisati to oblikovanje? Te akcije ni mogoče razveljaviti."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您確定要刪除此設計嗎？此操作無法撤消。"
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഈ ഡിസൈൻ ഇല്ലാതാക്കാൻ നിങ്ങൾ ഉറപ്പാണോ? ഈ പ്രവർത്തനം തിരികെ എടുക്കാൻ കഴിയില്ല."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณแน่ใจหรือว่าต้องการลบการออกแบบนี้? การกระทำนี้ไม่สามารถย้อนกลับได้."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Är du säker på att du vill ta bort denna design? Denna åtgärd kan inte ångras."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu tasarımı silmek istediğinize emin misiniz? Bu işlem geri alınamaz."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sind Sie sicher, dass Sie dieses Design löschen möchten? Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਕੀ ਤੁਸੀਂ ਯਕੀਨੀ ਹੋ ਕਿ ਤੁਸੀਂ ਇਸ ਡਿਜ਼ਾਈਨ ਨੂੰ ਹਟਾਉਣਾ ਚਾਹੁੰਦੇ ਹੋ? ਇਹ ਕਾਰਵਾਈ ਵਾਪਸ ਨਹੀਂ ਕੀਤੀ ਜਾ ਸਕਦੀ।"
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to delete this design? This action cannot be undone."
          }
