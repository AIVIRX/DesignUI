    "Every point needs a label and numeric value. Label and series pairs must be unique." : {
      "localizations" : {
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada punto necesita una etiqueta y un valor numérico. Las parejas de etiqueta y serie deben ser únicas."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvert punkt trenger en etikett og numerisk verdi. Etikett- og serienavnpar må være unike."
