          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রিয় সংরক্ষণ, ডিভাইসগুলির মধ্যে সিঙ্ক করতে এবং এক্সক্লুসিভ বৈশিষ্ট্যগুলিতে অ্যাক্সেস করতে আপনার অ্যাকাউন্ট তৈরি করুন।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea il tuo account per salvare i preferiti, sincronizzare tra i dispositivi e accedere a funzionalità esclusive."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δημιουργήστε τον λογαριασμό σας για να αποθηκεύσετε αγαπημένα, να συγχρονίσετε σε συσκευές και να αποκτήσετε πρόσβαση σε αποκλειστικές δυνατότητες."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आवडत्या गोष्टी जतन करण्यासाठी, उपकरणांमध्ये समन्वय साधण्यासाठी आणि विशेष वैशिष्ट्यांमध्ये प्रवेश करण्यासाठी तुमचे खाते तयार करा."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಆಕರ್ಷಕಗಳನ್ನು ಉಳಿಸಲು, ಸಾಧನಗಳ ನಡುವೆ ಸಮನ್ವಯಿಸಲು ಮತ್ತು ವಿಶೇಷ ವೈಶಿಷ್ಟ್ಯಗಳನ್ನು ಪ್ರವೇಶಿಸಲು ನಿಮ್ಮ ಖಾತೆ ರಚಿಸಿ."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Създайте акаунт, за да запазите любими, синхронизирате между устройства и получите достъп до ексклузивни функции."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utwórz konto, aby zapisywać ulubione, synchronizować między urządzeniami i uzyskiwać dostęp do ekskluzywnych funkcji."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kreiraj svoj račun da sačuvaš omiljene, sinhronizuješ između uređaja i pristupiš ekskluzivnim funkcijama."
          }
        },
        "ms" : {
