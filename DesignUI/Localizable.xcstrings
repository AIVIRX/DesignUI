          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luo tili tallentaaksesi suosikit, synkronoidaksesi laitteiden välillä ja päästäksesi käsiksi eksklusiivisiin ominaisuuksiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez votre compte pour enregistrer vos favoris, synchroniser sur plusieurs appareils et accéder à des fonctionnalités exclusives."
          }
