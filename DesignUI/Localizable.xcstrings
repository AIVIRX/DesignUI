    "Edit labels and values. Add a series name to compare groups; star a point to highlight it." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "value" : "Chỉnh sửa nhãn và giá trị. Thêm tên chuỗi để so sánh các nhóm; đánh dấu một điểm để làm nổi bật nó.",
            "state" : "translated"
          }
        },
        "bn" : {
          "stringUnit" : {
            "value" : "লেবেল এবং মান সম্পাদনা করুন। গ্রুপগুলি তুলনা করতে একটি সিরিজের নাম যোগ করুন; একটি পয়েন্ট হাইলাইট করতে একটি তারকা দিন।",
            "state" : "translated"
          }
        },
        "id" : {
          "stringUnit" : {
            "value" : "Edit label dan nilai. Tambahkan nama seri untuk membandingkan grup; tandai titik untuk menyorotnya.",
            "state" : "translated"
          }
        },
        "ml" : {
          "stringUnit" : {
            "value" : "लेबले आणि मूल्ये संपादित करा. गटांची तुलना करण्यासाठी एक मालिकेचे नाव जोडा; हायलाइट करण्यासाठी एक पॉइंट तारे करा.",
            "state" : "translated"
          }
        },
        "ms" : {
          "stringUnit" : {
            "value" : "Edit label dan nilai. Tambah nama siri untuk membandingkan kumpulan; bintangkan satu titik untuk menonjolkan ia.",
            "state" : "translated"
          }
        },
        "sk" : {
          "stringUnit" : {
            "value" : "Upraviť štítky a hodnoty. Pridajte názov série na porovnanie skupín; označte bod, aby ste ho zvýraznili.",
            "state" : "translated"
          }
        },
        "es-US" : {
          "stringUnit" : {
            "value" : "Edita etiquetas y valores. Agrega un nombre de serie para comparar grupos; marca un punto para resaltarlo.",
            "state" : "translated"
          }
        },
        "kk" : {
          "stringUnit" : {
            "value" : "Этикеттер мен мәндерді өңдеңіз. Топтарды салыстыру үшін серия атауын қосыңыз; нүктені ерекшелеу үшін жұлдызша қойыңыз.",
            "state" : "translated"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "Editar rótulos e valores. Adicione um nome de série para comparar grupos; destaque um ponto para o realçar.",
            "state" : "translated"
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "value" : "Edit labels and values. Add a series name to compare groups; star a point to highlight it.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Redigera etiketter och värden. Lägg till ett serienamn för att jämföra grupper; markera en punkt för att framhäva den.",
            "state" : "translated"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "value" : "Edit labels and values. Add a series name to compare groups; star a point to highlight it.",
            "state" : "translated"
          }
        },
        "pa" : {
          "stringUnit" : {
            "value" : "ਲੇਬਲ ਅਤੇ ਮੁੱਲ ਸੰਪਾਦਿਤ ਕਰੋ। ਸਮੂਹਾਂ ਦੀ ਤੁਲਨਾ ਕਰਨ ਲਈ ਇੱਕ ਸੀਰੀਜ਼ ਨਾਮ ਸ਼ਾਮਲ ਕਰੋ; ਇਸ ਨੂੰ ਹਾਈਲਾਈਟ ਕਰਨ ਲਈ ਇੱਕ ਪੌਇੰਟ ਨੂੰ ਤਾਰਾ ਕਰੋ।",
            "state" : "translated"
          }
        },
        "kn" : {
          "stringUnit" : {
            "value" : "ಲೇಬಲ್‌ಗಳನ್ನು ಮತ್ತು ಮೌಲ್ಯಗಳನ್ನು ಸಂಪಾದಿಸಿ. ಗುಂಪುಗಳನ್ನು ಹೋಲಿಸಲು ಸರಣಿಯ ಹೆಸರನ್ನು ಸೇರಿಸಿ; ಅದನ್ನು ಹೈಲೈಟ್ ಮಾಡಲು ಒಂದು ಪಾಯಿಂಟ್ ಅನ್ನು ತಾರೆ ಮಾಡಿ.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "ラベルと値を編集します。グループを比較するためにシリーズ名を追加し、ポイントをスターして強調表示します。",
            "state" : "translated"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "value" : "編輯標籤和數值。添加系列名稱以比較組別；標記一個點以突出顯示。",
            "state" : "translated"
          }
        },
        "he" : {
          "stringUnit" : {
            "value" : "ערוך תוויות וערכים. הוסף שם סדרה כדי להשוות קבוצות; סמן נקודה כדי להדגיש אותה.",
            "state" : "translated"
          }
        },
        "te" : {
          "stringUnit" : {
            "value" : "Edite rótulos e valores. Adicione um nome de série para comparar grupos; destaque um ponto para realçá-lo.",
            "state" : "translated"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "value" : "Edite rótulos e valores. Adicione um nome de série para comparar grupos; destaque um ponto para realçá-lo.",
            "state" : "translated"
          }
        },
        "hu" : {
          "stringUnit" : {
            "value" : "Címkék és értékek szerkesztése. Adj hozzá egy sorozatnevet a csoportok összehasonlításához; jelölj ki egy pontot, hogy kiemeld.",
            "state" : "translated"
          }
        },
        "mr" : {
          "stringUnit" : {
            "value" : "लेबल आणि मूल्ये संपादित करा. गटांची तुलना करण्यासाठी एक मालिकेचे नाव जोडा; हायलाइट करण्यासाठी एक पॉइंट तारे करा.",
            "state" : "translated"
          }
        },
        "hr" : {
          "stringUnit" : {
            "value" : "Uredi oznake i vrijednosti. Dodajte naziv serije za usporedbu grupa; označite točku da je istaknete.",
            "state" : "translated"
          }
        },
        "lt" : {
          "stringUnit" : {
            "value" : "Redaguokite etiketes ir vertes. Pridėkite serijos pavadinimą, kad palygintumėte grupes; pažymėkite tašką, kad jį išryškintumėte.",
            "state" : "translated"
          }
        },
        "sl" : {
          "stringUnit" : {
            "value" : "Uredi oznake in vrednosti. Dodajte ime serije za primerjavo skupin; označite točko, da jo izpostavite.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Labels und Werte bearbeiten. Fügen Sie einen Seriennamen hinzu, um Gruppen zu vergleichen; markieren Sie einen Punkt, um ihn hervorzuheben.",
            "state" : "translated"
          }
        },
        "el" : {
          "stringUnit" : {
            "value" : "Επεξεργαστείτε τις ετικέτες και τις τιμές. Προσθέστε ένα όνομα σειράς για να συγκρίνετε ομάδες; επισημάνετε ένα σημείο για να το τονίσετε.",
            "state" : "translated"
          }
        },
        "gu" : {
          "stringUnit" : {
            "value" : "લેબલ અને મૂલ્યો સંપાદિત કરો. જૂથોની તુલના કરવા માટે શ્રેણીનું નામ ઉમેરો; તેને હાઇલાઇટ કરવા માટે એક પોઈન્ટને તારાઓ.",
            "state" : "translated"
          }
        },
        "cs" : {
          "stringUnit" : {
            "value" : "Upravit štítky a hodnoty. Přidat název série pro porovnání skupin; označit bod pro jeho zvýraznění.",
            "state" : "translated"
          }
        },
        "ur" : {
          "stringUnit" : {
            "value" : "لیبلز اور اقدار میں ترمیم کریں۔ گروپوں کا موازنہ کرنے کے لیے ایک سیریز کا نام شامل کریں؛ ایک نقطہ کو نمایاں کرنے کے لیے ستارہ بنائیں۔",
            "state" : "translated"
          }
        },
        "ar" : {
          "stringUnit" : {
            "value" : "تحرير التسميات والقيم. أضف اسم سلسلة لمقارنة المجموعات؛ ضع نجمة على نقطة لتسليط الضوء عليها.",
            "state" : "translated"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "value" : "編輯標籤和數值。添加系列名稱以比較組；標記一個點以突出顯示。",
            "state" : "translated"
          }
        },
        "tr" : {
          "stringUnit" : {
            "value" : "Etiketleri ve değerleri düzenleyin. Grupları karşılaştırmak için bir seri adı ekleyin; bir noktayı vurgulamak için yıldızlayın.",
            "state" : "translated"
          }
        },
        "ca" : {
          "stringUnit" : {
            "value" : "Edita etiquetes i valors. Afegiu un nom de sèrie per comparar grups; destaca un punt per ressaltar-lo.",
