          }
        },
        "da" : {
          "stringUnit" : {
            "value" : "Rediger etiketter og værdier. Tilføj et serienavn for at sammenligne grupper; stjern et punkt for at fremhæve det.",
            "state" : "translated"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "value" : "编辑标签和值。添加系列名称以比较组；标记一个点以突出显示它。",
