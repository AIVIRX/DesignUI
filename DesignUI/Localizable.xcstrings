    "Every point needs a label and numeric value. Label and series pairs must be unique." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "value" : "Setiap titik memerlukan label dan nilai numerik. Pasangan label dan seri harus unik.",
            "state" : "translated"
          }
        },
        "ml" : {
          "stringUnit" : {
            "value" : "प्रत्येक पॉइंटला एक लेबल आणि संख्यात्मक मूल्य आवश्यक आहे. लेबल आणि मालिकेच्या जोड्या अद्वितीय असाव्यात.",
            "state" : "translated"
          }
        },
        "bn" : {
          "stringUnit" : {
            "value" : "প্রতিটি পয়েন্টের একটি লেবেল এবং সংখ্যাগত মান প্রয়োজন। লেবেল এবং সিরিজের জোড়া অনন্য হতে হবে।",
            "state" : "translated"
          }
        },
        "vi" : {
          "stringUnit" : {
            "value" : "Mỗi điểm cần có một nhãn và giá trị số. Cặp nhãn và chuỗi phải là duy nhất.",
            "state" : "translated"
          }
        },
        "ms" : {
          "stringUnit" : {
            "value" : "Setiap titik memerlukan label dan nilai numerik. Pasangan label dan siri mesti unik.",
            "state" : "translated"
          }
        },
        "sk" : {
          "stringUnit" : {
            "value" : "Každý bod potrebuje štítok a číselnú hodnotu. Pary štítkov a sérií musia byť jedinečné.",
            "state" : "translated"
          }
        },
        "es-US" : {
          "stringUnit" : {
            "value" : "Cada punto necesita una etiqueta y un valor numérico. Las parejas de etiqueta y serie deben ser únicas.",
            "state" : "translated"
          }
        },
        "kk" : {
          "stringUnit" : {
            "value" : "Әр нүкте үшін этикет және сандық мән қажет. Этикет пен серия жұптары бірегей болуы тиіс.",
            "state" : "translated"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "Cada ponto precisa de um rótulo e de um valor numérico. Os pares de rótulo e série devem ser únicos.",
            "state" : "translated"
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "value" : "Every point needs a label and numeric value. Label and series pairs must be unique.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Varje punkt behöver en etikett och ett numeriskt värde. Etikett- och serienamnpar måste vara unika.",
            "state" : "translated"
          }
        },
        "pa" : {
          "stringUnit" : {
            "value" : "ਹਰ ਪੌਇੰਟ ਨੂੰ ਇੱਕ ਲੇਬਲ ਅਤੇ ਗਿਣਤੀ ਮੁੱਲ ਦੀ ਲੋੜ ਹੁੰਦੀ ਹੈ। ਲੇਬਲ ਅਤੇ ਸੀਰੀਜ਼ ਜੋੜੇ ਵਿਲੱਖਣ ਹੋਣੇ ਚਾਹੀਦੇ ਹਨ।",
            "state" : "translated"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "value" : "Every point needs a label and numeric value. Label and series pairs must be unique.",
            "state" : "translated"
          }
        },
        "kn" : {
          "stringUnit" : {
            "value" : "ಪ್ರತಿ ಪಾಯಿಂಟ್‌ಗೆ ಲೇಬಲ್ ಮತ್ತು ಸಂಖ್ಯಾತ್ಮಕ ಮೌಲ್ಯ ಅಗತ್ಯವಿದೆ. ಲೇಬಲ್ ಮತ್ತು ಸರಣಿ ಜೋಡಿಗಳು ವಿಶಿಷ್ಟವಾಗಿರಬೇಕು.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "すべてのポイントにはラベルと数値が必要です。ラベルとシリーズのペアは一意でなければなりません。",
            "state" : "translated"
          }
        },
        "he" : {
          "stringUnit" : {
            "value" : "כל נקודה צריכה תווית וערך מספרי. תוויות וזוגות סדרות חייבים להיות ייחודיים.",
            "state" : "translated"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "value" : "每個點都需要一個標籤和數值。標籤和系列對必須是唯一的。",
            "state" : "translated"
          }
        },
        "te" : {
          "stringUnit" : {
            "value" : "Cada ponto precisa de um rótulo e um valor numérico. Rótulos e pares de séries devem ser únicos.",
            "state" : "translated"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "value" : "Cada ponto precisa de um rótulo e um valor numérico. Rótulos e pares de séries devem ser únicos.",
            "state" : "translated"
          }
        },
        "hu" : {
          "stringUnit" : {
            "value" : "Minden pontnak szüksége van egy címkére és egy numerikus értékre. A címke és sorozat pároknak egyedinek kell lenniük.",
            "state" : "translated"
          }
        },
        "mr" : {
          "stringUnit" : {
            "value" : "प्रत्येक पॉइंटला एक लेबल आणि संख्यात्मक मूल्य आवश्यक आहे. लेबल आणि मालिकेच्या जोड्या अद्वितीय असाव्यात.",
            "state" : "translated"
          }
        },
        "hr" : {
          "stringUnit" : {
            "value" : "Svaka točka treba oznaku i numeričku vrijednost. Oznake i parovi serija moraju biti jedinstveni.",
            "state" : "translated"
          }
        },
        "sl" : {
          "stringUnit" : {
            "value" : "Vsaka točka potrebuje oznako in numerično vrednost. Oznake in pari serij morajo biti edinstveni.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Jeder Punkt benötigt ein Label und einen numerischen Wert. Label- und Serienpaare müssen eindeutig sein.",
            "state" : "translated"
          }
        },
        "lt" : {
          "stringUnit" : {
            "value" : "Kiekvienas taškas turi turėti etiketę ir skaitinę vertę. Etikečių ir serijų poros turi būti unikalios.",
            "state" : "translated"
          }
        },
        "el" : {
          "stringUnit" : {
            "value" : "Κάθε σημείο χρειάζεται μια ετικέτα και μια αριθμητική τιμή. Οι ετικέτες και οι ζεύξεις σειρών πρέπει να είναι μοναδικές.",
            "state" : "translated"
          }
        },
        "gu" : {
          "stringUnit" : {
            "value" : "દરેક પોઈન્ટને એક લેબલ અને સંખ્યાત્મક મૂલ્યની જરૂર છે. લેબલ અને શ્રેણી જોડી અનન્ય હોવી જોઈએ.",
            "state" : "translated"
          }
        },
        "cs" : {
          "stringUnit" : {
            "value" : "Každý bod potřebuje štítek a číselnou hodnotu. Pary štítků a sérií musí být jedinečné.",
            "state" : "translated"
          }
        },
        "ur" : {
          "stringUnit" : {
            "value" : "ہر نقطے کو ایک لیبل اور عددی قیمت کی ضرورت ہوتی ہے۔ لیبل اور سیریز کے جوڑے منفرد ہونے چاہئیں۔",
            "state" : "translated"
          }
        },
        "ar" : {
          "stringUnit" : {
            "value" : "كل نقطة تحتاج إلى تسمية وقيمة عددية. يجب أن تكون أزواج التسمية والسلسلة فريدة.",
            "state" : "translated"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "value" : "每個點都需要一個標籤和數值。標籤和系列對必須是唯一的。",
            "state" : "translated"
          }
        },
        "ko" : {
          "stringUnit" : {
            "value" : "모든 포인트에는 레이블과 숫자 값이 필요합니다. 레이블과 시리즈 쌍은 고유해야 합니다.",
            "state" : "translated"
          }
        },
        "tr" : {
          "stringUnit" : {
            "value" : "Her noktanın bir etiketi ve sayısal değeri olmalıdır. Etiket ve seri çiftleri benzersiz olmalıdır.",
            "state" : "translated"
          }
        },
        "da" : {
          "stringUnit" : {
            "value" : "Hvert punkt har brug for en etikette og en numerisk værdi. Etikette- og serienavnepar skal være unikke.",
