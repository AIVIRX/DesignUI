    "Are you sure you want to delete this design? This action cannot be undone." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "value" : "Bạn có chắc chắn muốn xóa thiết kế này không? Hành động này không thể hoàn tác.",
            "state" : "translated"
          }
        },
        "bn" : {
          "stringUnit" : {
            "value" : "আপনি কি নিশ্চিত যে আপনি এই ডিজাইনটি মুছতে চান? এই পদক্ষেপটি পূর্বাবস্থায় ফিরিয়ে নেওয়া যাবে না।",
            "state" : "translated"
          }
        },
        "ml" : {
          "stringUnit" : {
            "value" : "ഈ ഡിസൈൻ നീക്കം ചെയ്യാൻ നിങ്ങൾ ഉറപ്പാണോ? ഈ പ്രവർത്തനം തിരികെ എടുക്കാൻ കഴിയില്ല.",
            "state" : "translated"
          }
        },
        "id" : {
          "stringUnit" : {
            "value" : "Apakah Anda yakin ingin menghapus desain ini? Tindakan ini tidak dapat dibatalkan.",
            "state" : "translated"
          }
        },
        "ms" : {
          "stringUnit" : {
            "value" : "Adakah anda pasti ingin memadam reka bentuk ini? Tindakan ini tidak boleh dibatalkan.",
            "state" : "translated"
          }
        },
        "sk" : {
          "stringUnit" : {
            "value" : "Ste si istí, že chcete odstrániť tento dizajn? Túto akciu nie je možné vrátiť späť.",
            "state" : "translated"
          }
        },
        "es-US" : {
          "stringUnit" : {
            "value" : "¿Estás seguro de que deseas eliminar este diseño? Esta acción no se puede deshacer.",
            "state" : "translated"
          }
        },
        "kk" : {
          "stringUnit" : {
            "value" : "Сіз осы жазбаны жоюға сенімдісіз бе? Бұл әрекет қайтарылмайды.",
            "state" : "translated"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "Tem certeza de que deseja eliminar este design? Esta ação não pode ser desfeita.",
            "state" : "translated"
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "value" : "Are you sure you want to delete this design? This action cannot be undone.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Är du säker på att du vill ta bort denna design? Denna åtgärd kan inte ångras.",
            "state" : "translated"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "value" : "Are you sure you want to delete this design? This action cannot be undone.",
            "state" : "translated"
          }
        },
        "pa" : {
          "stringUnit" : {
            "value" : "ਕੀ ਤੁਸੀਂ ਯਕੀਨੀ ਹੋ ਕਿ ਤੁਸੀਂ ਇਸ ਡਿਜ਼ਾਈਨ ਨੂੰ ਹਟਾਉਣਾ ਚਾਹੁੰਦੇ ਹੋ? ਇਹ ਕਾਰਵਾਈ ਵਾਪਸ ਨਹੀਂ ਕੀਤੀ ਜਾ ਸਕਦੀ।",
            "state" : "translated"
          }
        },
        "kn" : {
          "stringUnit" : {
            "value" : "ನೀವು ಈ ಡಿಸೈನ್ ಅನ್ನು ಅಳಿಸಲು ಖಚಿತವಾಗಿದ್ದೀರಾ? ಈ ಕ್ರಿಯೆಯನ್ನು ಹಿಂದಿರುಗಿಸಲಾಗುವುದಿಲ್ಲ.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "このデザインを削除してもよろしいですか？この操作は元に戻せません。",
            "state" : "translated"
          }
        },
        "he" : {
          "stringUnit" : {
            "value" : "האם אתה בטוח שברצונך למחוק את העיצוב הזה? פעולה זו אינה ניתנת לביטול.",
