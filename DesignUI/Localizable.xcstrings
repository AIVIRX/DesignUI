    "Create your account to save favorites, sync across devices, and access exclusive features." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشئ حسابك لحفظ المفضلات، والمزامنة عبر الأجهزة، والوصول إلى ميزات حصرية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Създайте акаунта си, за да запазите любими, синхронизирате между устройства и получите достъп до ексклузивни функции."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রিয় সংরক্ষণ করতে, ডিভাইসগুলির মধ্যে সিঙ্ক করতে এবং এক্সক্লুসিভ বৈশিষ্ট্যগুলিতে অ্যাক্সেস করতে আপনার অ্যাকাউন্ট তৈরি করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea el teu compte per desar favorits, sincronitzar entre dispositius i accedir a funcions exclusives."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvořte si účet, abyste mohli ukládat oblíbené položky, synchronizovat mezi zařízeními a mít přístup k exkluzivním funkcím."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opret din konto for at gemme favoritter, synkronisere på tværs af enheder og få adgang til eksklusive funktioner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellen Sie Ihr Konto, um Favoriten zu speichern, über Geräte hinweg zu synchronisieren und auf exklusive Funktionen zuzugreifen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δημιουργήστε τον λογαριασμό σας για να αποθηκεύσετε αγαπημένα, να συγχρονίσετε σε συσκευές και να αποκτήσετε πρόσβαση σε αποκλειστικά χαρακτηριστικά."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create your account to save favorites, sync across devices, and access exclusive features."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create your account to save favorites, sync across devices, and access exclusive features."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create your account to save favorites, sync across devices, and access exclusive features."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea tu cuenta para guardar favoritos, sincronizar entre dispositivos y acceder a funciones exclusivas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea tu cuenta para guardar favoritos, sincronizar entre dispositivos y acceder a funciones exclusivas."
