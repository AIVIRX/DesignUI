          }
        },
        "en-PH" : {
          "stringUnit" : {
            "value" : "Use this as a preview intensity control while testing variable color symbols.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Använd detta som en förhandsgranskningsintensitetskontroll när du testar variabla färgsymboler.",
            "state" : "translated"
          }
        },
        "pa" : {
          "stringUnit" : {
            "value" : "ਇਸਨੂੰ ਵੈਰੀਏਬਲ ਰੰਗ ਦੇ ਪ੍ਰਤੀਕਾਂ ਦੀ ਜਾਂਚ ਕਰਦੇ ਸਮੇਂ ਪੂਰਕ ਤੀਬਰਤਾ ਨਿਯੰਤਰ ਵਜੋਂ ਵਰਤੋਂ ਕਰੋ।",
