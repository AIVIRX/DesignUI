    "You need to be signed in to like a design." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "value" : "Bạn cần đăng nhập để thích một thiết kế.",
            "state" : "translated"
          }
        },
        "bn" : {
          "stringUnit" : {
            "value" : "আপনাকে একটি ডিজাইন পছন্দ করতে সাইন ইন করতে হবে।",
            "state" : "translated"
          }
        },
        "ml" : {
          "stringUnit" : {
            "value" : "ഒരു ഡിസൈൻ ഇഷ്ടപ്പെടാൻ സൈൻ ഇൻ ചെയ്യേണ്ടതാണ്.",
            "state" : "translated"
          }
        },
        "id" : {
          "stringUnit" : {
            "value" : "Anda perlu masuk untuk menyukai desain.",
            "state" : "translated"
          }
        },
        "ms" : {
          "stringUnit" : {
            "value" : "Anda perlu log masuk untuk menyukai reka bentuk.",
            "state" : "translated"
          }
        },
        "sk" : {
          "stringUnit" : {
            "value" : "Musíte byť prihlásený, aby ste mohli odosielať dizajny do komunity.",
            "state" : "translated"
          }
        },
        "es-US" : {
          "stringUnit" : {
            "value" : "Necesitas estar conectado para enviar diseños a la comunidad.",
            "state" : "translated"
          }
        },
        "kk" : {
          "stringUnit" : {
            "value" : "Қоғамға дизайндарды жіберу үшін кірген болуыңыз керек.",
            "state" : "translated"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "Você precisa estar autenticado para gostar de um design.",
            "state" : "translated"
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "value" : "You need to be signed in to like a design.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Kräver inloggning för att skicka in designer till gemenskapen.",
            "state" : "translated"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "value" : "You need to be signed in to like a design.",
            "state" : "translated"
          }
        },
        "pa" : {
          "stringUnit" : {
            "value" : "ਤੁਹਾਨੂੰ ਇੱਕ ਡਿਜ਼ਾਈਨ ਨੂੰ ਪਸੰਦ ਕਰਨ ਲਈ ਸਾਈਨ ਇਨ ਹੋਣਾ ਚਾਹੀਦਾ ਹੈ।",
            "state" : "translated"
          }
        },
        "kn" : {
          "stringUnit" : {
            "value" : "ನೀವು ಸಮುದಾಯಕ್ಕೆ ವಿನ್ಯಾಸಗಳನ್ನು ಸಲ್ಲಿಸಲು ಸೈನ್ ಇನ್ ಆಗಿರಬೇಕು.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "コミュニティにデザインを提出するにはサインインする必要があります。",
            "state" : "translated"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "value" : "您需要登入才能喜歡設計。",
            "state" : "translated"
          }
        },
        "he" : {
          "stringUnit" : {
            "value" : "עליך להיות מחובר כדי לאהוב עיצוב.",
            "state" : "translated"
          }
        },
        "te" : {
          "stringUnit" : {
            "value" : "Necesitas estar conectado para gustar un diseño.",
            "state" : "translated"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "value" : "Você precisa estar logado para curtir um design.",
            "state" : "translated"
          }
        },
        "hu" : {
          "stringUnit" : {
            "value" : "Be kell jelentkeznie, hogy tetszést nyilváníthasson egy dizájnra.",
            "state" : "translated"
          }
        },
        "mr" : {
          "stringUnit" : {
            "value" : "तुम्हाला एक डिझाइन आवडण्यासाठी साइन इन केलेले असणे आवश्यक आहे.",
            "state" : "translated"
          }
        },
        "hr" : {
          "stringUnit" : {
            "value" : "Morate biti prijavljeni da biste poslali dizajne zajednici.",
            "state" : "translated"
          }
        },
        "lt" : {
          "stringUnit" : {
            "value" : "Norint patikti dizainui, turite būti prisijungę.",
            "state" : "translated"
          }
        },
        "sl" : {
          "stringUnit" : {
            "value" : "Moraš biti prijavljen, da lahko oceniš oblikovanje.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Sie müssen angemeldet sein, um ein Design zu mögen.",
            "state" : "translated"
          }
        },
        "el" : {
          "stringUnit" : {
            "value" : "Πρέπει να είστε συνδεδεμένοι για να σας αρέσει ένα σχέδιο.",
            "state" : "translated"
          }
        },
        "gu" : {
          "stringUnit" : {
            "value" : "તમે સમુદાયને ડિઝાઇન સબમિટ કરવા માટે સાઇન ઇન થવા જરૂરી છે.",
            "state" : "translated"
          }
        },
        "cs" : {
          "stringUnit" : {
            "value" : "Musíte být přihlášeni, abyste mohli mít rádi design.",
            "state" : "translated"
          }
        },
        "ur" : {
          "stringUnit" : {
            "value" : "آپ کو کمیونٹی میں ڈیزائن جمع کرنے کے لیے سائن ان ہونا ضروری ہے۔",
            "state" : "translated"
          }
        },
        "ar" : {
          "stringUnit" : {
            "value" : "يجب أن تكون مسجلاً للدخول لإعجاب بتصميم.",
            "state" : "translated"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "value" : "你需要登入才能向社區提交設計。",
            "state" : "translated"
          }
        },
        "tr" : {
