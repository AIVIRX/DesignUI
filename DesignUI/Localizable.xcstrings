    "Keep your work, preferences, and saved designs available wherever you use Dock UI." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "value" : "Giữ công việc, sở thích và thiết kế đã lưu của bạn có sẵn ở bất kỳ đâu bạn sử dụng Dock UI.",
            "state" : "translated"
          }
        },
        "bn" : {
          "stringUnit" : {
            "value" : "আপনার কাজ, পছন্দ এবং সংরক্ষিত ডিজাইনগুলি যেখানে আপনি ডক ইউআই ব্যবহার করেন সেখানে উপলব্ধ থাকবে।",
            "state" : "translated"
          }
        },
        "id" : {
          "stringUnit" : {
            "value" : "Simpan pekerjaan, preferensi, dan desain yang disimpan agar tersedia di mana pun Anda menggunakan Dock UI.",
            "state" : "translated"
          }
        },
        "ml" : {
          "stringUnit" : {
            "value" : "നിങ്ങളുടെ ജോലി, മുൻഗണനകൾ, സേവ് ചെയ്ത ഡിസൈനുകൾ ഡോക്ക് UI ഉപയോഗിക്കുന്ന എല്ലാ സ്ഥലങ്ങളിലും ലഭ്യമാക്കുക.",
            "state" : "translated"
          }
        },
        "ms" : {
          "stringUnit" : {
            "value" : "Simpan kerja, pilihan, dan reka bentuk yang disimpan tersedia di mana sahaja anda menggunakan Dock UI.",
            "state" : "translated"
          }
        },
        "sk" : {
          "stringUnit" : {
            "value" : "Udržujte svoju prácu, preferencie a uložené návrhy dostupné kdekoľvek používate Dock UI.",
            "state" : "translated"
          }
        },
        "es-US" : {
          "stringUnit" : {
            "value" : "Mantén tu trabajo, preferencias y diseños guardados disponibles donde sea que uses Dock UI.",
            "state" : "translated"
          }
        },
        "kk" : {
          "stringUnit" : {
            "value" : "Dock UI-ды пайдаланған кезде жұмысыңызды, параметрлеріңізді және сақталған дизайндарды қолжетімді етіңіз.",
            "state" : "translated"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "Mantenha o seu trabalho, preferências e designs guardados disponíveis onde quer que utilize a Dock UI.",
            "state" : "translated"
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "value" : "Keep your work, preferences, and saved designs available wherever you use Dock UI.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Håll ditt arbete, inställningar och sparade designer tillgängliga var du än använder Dock UI.",
            "state" : "translated"
          }
        },
        "pa" : {
          "stringUnit" : {
            "value" : "ਤੁਹਾਡਾ ਕੰਮ, ਪਸੰਦਾਂ ਅਤੇ ਸੁਰੱਖਿਅਤ ਡਿਜ਼ਾਈਨ ਜਿੱਥੇ ਵੀ ਤੁਸੀਂ ਡੌਕ ਯੂਆਈ ਦੀ ਵਰਤੋਂ ਕਰਦੇ ਹੋ ਉੱਥੇ ਉਪਲਬਧ ਰਹਿਣਗੇ।",
            "state" : "translated"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "value" : "Keep your work, preferences, and saved designs available wherever you use Dock UI.",
            "state" : "translated"
          }
        },
        "kn" : {
          "stringUnit" : {
            "value" : "ನಿಮ್ಮ ಕೆಲಸ, ಆಯ್ಕೆಗಳು ಮತ್ತು ಉಳಿಸಿದ ವಿನ್ಯಾಸಗಳನ್ನು ಡಾಕ್ ಯುಐ ಬಳಸುವ ಎಲ್ಲೆಡೆ ಲಭ್ಯವಿರುತ್ತವೆ.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "Dock UIを使用する場所で、作業、設定、および保存されたデザインを利用できるようにします。",
            "state" : "translated"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "value" : "在您使用 Dock UI 的任何地方保留您的工作、偏好設置和已保存的設計。",
            "state" : "translated"
          }
        },
        "he" : {
          "stringUnit" : {
            "value" : "שמור את העבודה שלך, העדפות, ועיצובים שמורים זמינים בכל מקום שבו אתה משתמש ב-Dock UI.",
            "state" : "translated"
          }
        },
        "te" : {
          "stringUnit" : {
            "value" : "Panatilihin ang iyong trabaho, mga kagustuhan, at mga na-save na disenyo na magagamit saanman mo gamitin ang Dock UI.",
            "state" : "translated"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "value" : "Mantenha seu trabalho, preferências e designs salvos disponíveis onde quer que você use a interface Dock UI.",
            "state" : "translated"
          }
        },
        "hu" : {
          "stringUnit" : {
            "value" : "Tartsd meg a munkádat, beállításaidat és a mentett terveidet, bárhol is használod a Dock UI-t.",
            "state" : "translated"
          }
        },
        "mr" : {
          "stringUnit" : {
            "value" : "तुमचे काम, प्राधान्ये, आणि जतन केलेले डिझाइन Dock UI वर कुठेही उपलब्ध राहतील.",
            "state" : "translated"
          }
        },
        "hr" : {
          "stringUnit" : {
            "value" : "Zadržite svoj rad, postavke i spremljene dizajne dostupne gdje god koristite Dock UI.",
            "state" : "translated"
          }
        },
        "sl" : {
          "stringUnit" : {
            "value" : "Ohrani svoje delo, nastavitve in shranjene zasnove dostopne kjerkoli uporabljaš Dock UI.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Halten Sie Ihre Arbeiten, Einstellungen und gespeicherten Designs überall verfügbar, wo Sie Dock UI verwenden.",
            "state" : "translated"
          }
        },
        "lt" : {
          "stringUnit" : {
            "value" : "Išlaikykite savo darbą, nustatymus ir išsaugotus dizainus prieinamus bet kur, kur naudojate Dock UI.",
            "state" : "translated"
          }
        },
        "el" : {
          "stringUnit" : {
            "value" : "Διατηρήστε τη δουλειά σας, τις προτιμήσεις και τα αποθηκευμένα σχέδια διαθέσιμα όπου κι αν χρησιμοποιείτε το Dock UI.",
            "state" : "translated"
          }
        },
        "gu" : {
          "stringUnit" : {
            "value" : "તમારું કામ, પસંદગીઓ અને સાચવેલ ડિઝાઇનને ડોક યુઆઈનો ઉપયોગ કરતી વખતે ઉપલબ્ધ રાખો.",
            "state" : "translated"
          }
        },
        "cs" : {
          "stringUnit" : {
            "value" : "Udržujte svou práci, preference a uložené návrhy dostupné kdekoli používáte Dock UI.",
            "state" : "translated"
          }
        },
        "ur" : {
          "stringUnit" : {
            "value" : "اپنے کام، ترجیحات، اور محفوظ کردہ ڈیزائن کو Dock UI کے ساتھ جہاں بھی استعمال کریں، دستیاب رکھیں۔",
            "state" : "translated"
          }
        },
        "ar" : {
          "stringUnit" : {
            "value" : "احتفظ بعملك وتفضيلاتك والتصاميم المحفوظة متاحة أينما استخدمت واجهة Dock.",
            "state" : "translated"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "value" : "隨時隨地使用 Dock UI，保持您的工作、偏好設置和已保存的設計可用。",
            "state" : "translated"
          }
        },
        "tr" : {
          "stringUnit" : {
            "value" : "Çalışmalarınızı, tercihlerinizi ve kaydedilmiş tasarımlarınızı Dock UI'yi kullandığınız her yerde erişilebilir tutun.",
            "state" : "translated"
          }
        },
        "ca" : {
          "stringUnit" : {
            "value" : "Mantingues la teva feina, preferències i dissenys desats disponibles a qualsevol lloc on utilitzis Dock UI.",
            "state" : "translated"
          }
        },
        "da" : {
          "stringUnit" : {
            "value" : "Hold dit arbejde, præferencer og gemte designs tilgængelige, uanset hvor du bruger Dock UI.",
            "state" : "translated"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "value" : "在您使用 Dock UI 的任何地方，保持您的工作、偏好设置和保存的设计可用。",
            "state" : "translated"
          }
        },
        "ko" : {
          "stringUnit" : {
            "value" : "Dock UI를 사용하는 모든 곳에서 작업, 환경 설정 및 저장된 디자인을 사용할 수 있습니다.",
            "state" : "translated"
          }
        },
        "or" : {
          "stringUnit" : {
            "value" : "अपने काम, प्राथमिकताएँ, और सहेजे गए डिज़ाइन को Dock UI के साथ जहाँ भी आप उपयोग करें, उपलब्ध रखें।",
            "state" : "translated"
          }
        },
        "nb" : {
          "stringUnit" : {
            "value" : "Hold arbeidet ditt, innstillinger og lagrede design tilgjengelig uansett hvor du bruker Dock UI.",
            "state" : "translated"
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "value" : "Keep your work, preferences, and saved designs available wherever you use Dock UI.",
            "state" : "translated"
          }
        },
        "ta" : {
          "stringUnit" : {
            "value" : "अपने काम, प्राथमिकताएँ, और सहेजे गए डिज़ाइन को Dock UI के साथ जहाँ भी आप उपयोग करें, उपलब्ध रखें।",
            "state" : "translated"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "value" : "Mantén tu trabajo, preferencias y diseños guardados disponibles donde sea que uses Dock UI.",
            "state" : "translated"
          }
        },
        "th" : {
          "stringUnit" : {
            "value" : "เก็บงาน การตั้งค่า และการออกแบบที่บันทึกไว้ให้พร้อมใช้งานทุกที่ที่คุณใช้ Dock UI.",
            "state" : "translated"
          }
        },
        "ru" : {
          "stringUnit" : {
            "value" : "Сохраняйте свою работу, настройки и сохраненные дизайны доступными везде, где вы используете Dock UI.",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "Mantieni il tuo lavoro, le preferenze e i design salvati disponibili ovunque utilizzi Dock UI.",
            "state" : "translated"
          }
        },
        "pl" : {
          "stringUnit" : {
            "value" : "Zachowaj swoją pracę, preferencje i zapisane projekty dostępne wszędzie tam, gdzie używasz Dock UI.",
            "state" : "translated"
          }
        },
        "es" : {
