    "Use this as a preview intensity control while testing variable color symbols." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم هذا كتحكم في شدة المعاينة أثناء اختبار رموز الألوان المتغيرة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Използвай това като контрол на интензивността на предварителния преглед, докато тествате променливи цветови символи."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভেরিয়েবল রঙের প্রতীক পরীক্ষা করার সময় এটি একটি প্রিভিউ তীব্রতা নিয়ন্ত্রণ হিসাবে ব্যবহার করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilitza això com a control d'intensitat de vista prèvia mentre proves símbols de color variable."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proměnná barva"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug dette som en forhåndsvisningsintensitetskontrol, mens du tester variable farvesymboler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie dies als Vorschau-Intensitätssteuerung, während Sie variable Farbsymbole testen."
          }
