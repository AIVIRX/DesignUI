        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "മുക്ത ഉപയോക്താക്കൾക്ക് %lld ഡിസൈനുകൾക്ക് പരിമിതമാണ്. അനന്തമായ ഡിസൈനുകൾ സൃഷ്ടിക്കാൻ സബ്സ്ക്രൈബ് ചെയ്യുക."
