    "Create your account to save favorites, sync across devices, and access exclusive features." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea el teu compte per desar favorits, sincronitzar entre dispositius i accedir a funcions exclusives."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создайте свой аккаунт, чтобы сохранять избранное, синхронизировать между устройствами и получать доступ к эксклюзивным функциям."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvorte si účet, aby ste si uložili obľúbené položky, synchronizovali medzi zariadeniami a získali prístup k exkluzívnym funkciám."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create your account to save favorites, sync across devices, and access exclusive features."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צור את החשבון שלך כדי לשמור מועדפים, לסנכרן בין מכשירים, ולגשת לתכונות בלעדיות."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "즐겨찾기를 저장하고, 장치 간 동기화하며, 독점 기능에 접근하려면 계정을 만드세요."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez votre compte pour enregistrer vos favoris, synchroniser sur plusieurs appareils et accéder à des fonctionnalités exclusives."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustvarite svoj račun, da shranite priljubljene, sinhronizirate med napravami in dostopate do ekskluzivnih funkcij."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "創建您的帳戶以保存收藏、在設備之間同步並訪問獨家功能。"
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പ്രിയപ്പെട്ടവ സംരക്ഷിക്കാൻ, ഉപകരണങ്ങൾക്കിടയിൽ സമന്വയിപ്പിക്കാൻ, പ്രത്യേക സവിശേഷതകൾക്ക് പ്രവേശിക്കാൻ നിങ്ങളുടെ അക്കൗണ്ട് സൃഷ്ടിക്കുക."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สร้างบัญชีของคุณเพื่อบันทึกสิ่งที่ชื่นชอบ, ซิงค์ข้ามอุปกรณ์, และเข้าถึงฟีเจอร์พิเศษ."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favorileri kaydetmek, cihazlar arasında senkronize olmak ve özel özelliklere erişmek için hesabınızı oluşturun."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skapa ditt konto för att spara favoriter, synkronisera över enheter och få tillgång till exklusiva funktioner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellen Sie Ihr Konto, um Favoriten zu speichern, über Geräte hinweg zu synchronisieren und auf exklusive Funktionen zuzugreifen."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਆਪਣਾ ਖਾਤਾ ਬਣਾਓ ਤਾਂ ਜੋ ਮਨਪਸੰਦ ਨੂੰ ਸੁਰੱਖਿਅਤ ਕਰ ਸਕੋ, ਉਪਕਰਨਾਂ ਵਿੱਚ ਸਿੰਕ ਕਰ ਸਕੋ, ਅਤੇ ਵਿਸ਼ੇਸ਼ ਫੀਚਰਾਂ ਤੱਕ ਪਹੁੰਚ ਸਕੋ।"
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create your account to save favorites, sync across devices, and access exclusive features."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشئ حسابك لحفظ المفضلات، والمزامنة عبر الأجهزة، والوصول إلى ميزات حصرية."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "创建您的账户以保存收藏、在设备间同步并访问独家功能。"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hozd létre a fiókodat, hogy elmentsd a kedvenceidet, szinkronizálj az eszközök között, és hozzáférj az exkluzív funkciókhoz."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favorileri kaydetmek, cihazlar arasında senkronize olmak ve özel özelliklere erişmek için hesabınızı oluşturun."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opret din konto for at gemme favoritter, synkronisere på tværs af enheder og få adgang til eksklusive funktioner."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tạo tài khoản của bạn để lưu các mục yêu thích, đồng bộ trên các thiết bị và truy cập các tính năng độc quyền."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "創建您的帳戶以保存收藏、在設備之間同步並訪問獨家功能。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buat akun Anda untuk menyimpan favorit, menyinkronkan di berbagai perangkat, dan mengakses fitur eksklusif."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Створіть свій обліковий запис, щоб зберегти улюблені, синхронізувати між пристроями та отримати доступ до ексклюзивних функцій."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पसंदीदा सहेजने, उपकरणों के बीच समन्वय करने और विशेष सुविधाओं तक पहुँचने के लिए अपना खाता बनाएँ।"
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ફેવરિટ્સ સાચવવા, ડિવાઇસમાં સમન્વયિત કરવા અને વિશિષ્ટ સુવિધાઓનો ઉપયોગ કરવા માટે તમારું ખાતું બનાવો."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنا اکاؤنٹ بنائیں تاکہ پسندیدہ محفوظ کریں، آلات کے درمیان ہم آہنگ کریں، اور خصوصی خصوصیات تک رسائی حاصل کریں۔"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お気に入りを保存し、デバイス間で同期し、限定機能にアクセスするためにアカウントを作成してください。"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvořte si účet, abyste mohli ukládat oblíbené položky, synchronizovat mezi zařízeními a mít přístup k exkluzivním funkcím."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak je account aan om favorieten op te slaan, te synchroniseren tussen apparaten en toegang te krijgen tot exclusieve functies."
          }
        },
        "en-GB" : {
          "stringUnit" : {
