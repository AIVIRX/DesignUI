    "Use this as a preview intensity control while testing variable color symbols." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "value" : "Sử dụng điều này như một điều khiển cường độ xem trước trong khi thử nghiệm các biểu tượng màu biến đổi.",
            "state" : "translated"
          }
        },
        "ml" : {
          "stringUnit" : {
            "value" : "വ്യത്യസ്ത നിറത്തിലുള്ള ചിഹ്നങ്ങൾ പരീക്ഷിക്കുമ്പോൾ പ്രിവ്യൂ ഇന്റൻസിറ്റി നിയന്ത്രണമായി ഇത് ഉപയോഗിക്കുക.",
            "state" : "translated"
          }
        },
        "id" : {
          "stringUnit" : {
            "value" : "Gunakan ini sebagai kontrol intensitas pratinjau saat menguji simbol warna variabel.",
            "state" : "translated"
          }
        },
        "bn" : {
          "stringUnit" : {
            "value" : "ভেরিয়েবল রঙের প্রতীক পরীক্ষা করার সময় এটি একটি প্রিভিউ তীব্রতা নিয়ন্ত্রণ হিসাবে ব্যবহার করুন।",
            "state" : "translated"
          }
        },
        "ms" : {
          "stringUnit" : {
            "value" : "Gunakan ini sebagai kawalan intensiti pratonton semasa menguji simbol warna berubah-ubah.",
            "state" : "translated"
          }
        },
        "sk" : {
          "stringUnit" : {
            "value" : "Variabilná farba",
            "state" : "translated"
          }
        },
        "es-US" : {
          "stringUnit" : {
            "value" : "Usa esto como un control de intensidad de vista previa mientras pruebas símbolos de color variable.",
            "state" : "translated"
          }
        },
        "kk" : {
          "stringUnit" : {
            "value" : "Айнымалы түсті символдарды тестілеу кезінде алдын ала қарау қарқындылығы басқару элементі ретінде пайдаланыңыз.",
            "state" : "translated"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "Use isto como um controle de intensidade de pré-visualização ao testar símbolos de cor variável.",
