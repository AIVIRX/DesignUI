          }
        },
        "mr" : {
          "stringUnit" : {
            "value" : "तुम्हाला हा डिझाइन हटवायचा आहे का? हा क्रियाकलाप पूर्ववत केला जाऊ शकत नाही.",
            "state" : "translated"
          }
        },
        "hr" : {
          "stringUnit" : {
            "value" : "Jesi li siguran da želiš izbrisati ovaj dizajn? Ova radnja se ne može poništiti.",
