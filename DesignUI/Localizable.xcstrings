          }
        },
        "en-GB" : {
          "stringUnit" : {
            "value" : "Use this as a preview intensity control while testing variable color symbols.",
            "state" : "translated"
          }
        },
        "kn" : {
          "stringUnit" : {
            "value" : "ಬದಲಾಯಿಸುವ ಬಣ್ಣದ ಚಿಹ್ನೆಗಳನ್ನು ಪರೀಕ್ಷಿಸುವಾಗ ಪೂರ್ವದೃಶ್ಯ ತೀವ್ರತೆ ನಿಯಂತ್ರಣವಾಗಿ ಇದನ್ನು ಬಳಸಿರಿ.",
