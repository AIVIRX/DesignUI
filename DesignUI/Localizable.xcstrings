    "Edit labels and values. Add a series name to compare groups; star a point to highlight it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Labels und Werte bearbeiten. Fügen Sie einen Seriennamen hinzu, um Gruppen zu vergleichen; markieren Sie einen Punkt, um ihn hervorzuheben."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "编辑标签和值。添加系列名称以比较组；标记一个点以突出显示。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಲೇಬಲ್‌ಗಳನ್ನು ಮತ್ತು ಮೌಲ್ಯಗಳನ್ನು ಸಂಪಾದಿಸಿ. ಗುಂಪುಗಳನ್ನು ಹೋಲಿಸಲು ಸರಣಿಯ ಹೆಸರನ್ನು ಸೇರಿಸಿ; ಅದನ್ನು ಹೈಲೈಟ್ ಮಾಡಲು ಒಂದು ಪಾಯಿಂಟ್ ಅನ್ನು ತಾರೆ ಮಾಡಿ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แก้ไขป้ายชื่อและค่า เพิ่มชื่อชุดเพื่อเปรียบเทียบกลุ่ม; ทำเครื่องหมายจุดเพื่อเน้นมัน"
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edita etiquetas y valores. Agrega un nombre de serie para comparar grupos; marca un punto para resaltarlo."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edit labels and values. Add a series name to compare groups; star a point to highlight it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifier les étiquettes et les valeurs. Ajouter un nom de série pour comparer des groupes ; étoile un point pour le mettre en évidence."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redaguokite etiketes ir vertes. Pridėkite serijos pavadinimą, kad palygintumėte grupes; pažymėkite tašką, kad jį išryškintumėte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifica etichette e valori. Aggiungi un nome di serie per confrontare i gruppi; evidenzia un punto per metterlo in risalto."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Címkék és értékek szerkesztése. Adj hozzá egy sorozatnevet a csoportok összehasonlításához; jelölj ki egy pontot, hogy kiemeld."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edita etiquetes i valors. Afegiu un nom de sèrie per comparar grups; destaca un punt per ressaltar-lo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewerk labels en waarden. Voeg een serie naam toe om groepen te vergelijken; markeer een punt om het te benadrukken."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "লেবেল এবং মান সম্পাদনা করুন। গ্রুপগুলি তুলনা করতে একটি সিরিজের নাম যোগ করুন; একটি পয়েন্ট হাইলাইট করতে একটি তারকা দিন।"
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "લેબલ અને મૂલ્યો સંપાદિત કરો. જૂથોની તુલના કરવા માટે શ્રેણીનું નામ ઉમેરો; તેને હાઇલાઇટ કરવા માટે એક પોઈન્ટને તારાઓ."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edit label dan nilai. Tambah nama siri untuk membandingkan kumpulan; bintangkan satu titik untuk menonjolkan ia."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحرير التسميات والقيم. أضف اسم سلسلة لمقارنة المجموعات؛ ضع نجمة على نقطة لتسليط الضوء عليها."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編輯標籤和數值。添加系列名稱以比較組別；標記一個點以突出顯示。"
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edit labels and values. Add a series name to compare groups; star a point to highlight it."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upravit štítky a hodnoty. Přidat název série pro porovnání skupin; označit bod pro jeho zvýraznění."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "编辑标签和值。添加系列名称以比较组；标记一个点以突出显示它。"
