        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಮುಕ್ತ ಬಳಕೆದಾರರು %lld ವಿನ್ಯಾಸಗಳಿಗೆ ಮಿತಿಯಲ್ಲಿದ್ದಾರೆ. ನಿರಂತರ ವಿನ್ಯಾಸಗಳನ್ನು ರಚಿಸಲು ಚಂದಾದಾರರಾಗಿರಿ."
