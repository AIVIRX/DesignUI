    "Use distinct labels, nonnegative values and a total above zero." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "value" : "Gunakan label yang berbeda, nilai nonnegatif, dan total di atas nol.",
            "state" : "translated"
          }
        },
        "ml" : {
          "stringUnit" : {
            "value" : "വ്യത്യസ്ത ലേബലുകൾ, നെഗറ്റീവ് അല്ലാത്ത മൂല്യങ്ങൾ, ശൂന്യത്തിൽ മുകളിൽ ഒരു മൊത്തം ഉപയോഗിക്കുക.",
            "state" : "translated"
          }
        },
        "bn" : {
          "stringUnit" : {
            "value" : "স্বতন্ত্র লেবেল, অ-নেতিবাচক মান এবং শূন্যের উপরে একটি মোট ব্যবহার করুন।",
            "state" : "translated"
          }
        },
        "vi" : {
          "stringUnit" : {
            "value" : "Sử dụng nhãn khác nhau, giá trị không âm và tổng lớn hơn không.",
            "state" : "translated"
          }
        },
        "ms" : {
          "stringUnit" : {
            "value" : "Gunakan label yang berbeza, nilai tidak negatif dan jumlah di atas sifar.",
            "state" : "translated"
          }
        },
        "sk" : {
          "stringUnit" : {
            "value" : "Používajte odlišné štítky, kladné hodnoty a celkovú hodnotu nad nulou.",
            "state" : "translated"
          }
        },
        "es-US" : {
          "stringUnit" : {
            "value" : "Usa etiquetas distintas, valores no negativos y un total superior a cero.",
            "state" : "translated"
          }
        },
        "kk" : {
          "stringUnit" : {
            "value" : "Айқын белгілерді, теріс емес мәндерді және нөлден жоғары жалпы мәнді пайдаланыңыз.",
            "state" : "translated"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "Utilize rótulos distintos, valores não negativos e um total acima de zero.",
            "state" : "translated"
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "value" : "Use distinct labels, nonnegative values and a total above zero.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Använd distinkta etiketter, icke-negativa värden och en total över noll.",
            "state" : "translated"
          }
        },
        "pa" : {
          "stringUnit" : {
            "value" : "ਵੱਖਰੇ ਲੇਬਲ, ਨਕਾਰਾਤਮਕ ਮੁੱਲ ਅਤੇ ਜ਼ੀਰੋ ਤੋਂ ਉੱਪਰ ਕੁੱਲ ਦੀ ਵਰਤੋਂ ਕਰੋ।",
            "state" : "translated"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "value" : "Use distinct labels, nonnegative values and a total above zero.",
            "state" : "translated"
          }
        },
        "kn" : {
          "stringUnit" : {
            "value" : "ವಿಭಿನ್ನ ಲೇಬಲ್‌ಗಳನ್ನು, ಋಣಾತ್ಮಕವಲ್ಲದ ಮೌಲ್ಯಗಳನ್ನು ಮತ್ತು ಶೂನ್ಯಕ್ಕಿಂತ ಹೆಚ್ಚು ಒಟ್ಟು ಬಳಸಿರಿ.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "異なるラベル、非負の値、および合計がゼロ以上であることを使用してください。",
            "state" : "translated"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "value" : "使用不同的標籤、非負值和總數大於零。",
            "state" : "translated"
          }
        },
        "he" : {
          "stringUnit" : {
            "value" : "השתמש בתוויות שונות, ערכים לא שליליים וסכום מעל אפס.",
            "state" : "translated"
          }
        },
        "te" : {
          "stringUnit" : {
            "value" : "Gumamit ng natatanging mga label, hindi negatibong mga halaga at isang kabuuan na higit sa zero.",
            "state" : "translated"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "value" : "Use rótulos distintos, valores não negativos e um total acima de zero.",
            "state" : "translated"
          }
        },
        "hu" : {
          "stringUnit" : {
            "value" : "Használj különböző címkéket, nem negatív értékeket és összesen nulla felettit.",
            "state" : "translated"
          }
        },
        "mr" : {
          "stringUnit" : {
            "value" : "विशिष्ट लेबल, नकारात्मक नसलेले मूल्ये आणि शून्याच्या वर एकूण वापरा.",
            "state" : "translated"
          }
        },
        "hr" : {
          "stringUnit" : {
            "value" : "Koristite različite oznake, nenegativne vrijednosti i ukupno iznad nule.",
            "state" : "translated"
          }
        },
        "sl" : {
          "stringUnit" : {
            "value" : "Uporabite ločene oznake, nenegativne vrednosti in skupno nad nič.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Verwenden Sie unterschiedliche Bezeichnungen, nichtnegative Werte und eine Summe über null.",
            "state" : "translated"
          }
        },
        "lt" : {
          "stringUnit" : {
            "value" : "Naudokite skirtingas etiketes, neigiamas vertes ir bendrą, didesnį už nulį.",
            "state" : "translated"
          }
        },
        "el" : {
          "stringUnit" : {
            "value" : "Χρησιμοποιήστε διακριτές ετικέτες, μη αρνητικές τιμές και ένα σύνολο πάνω από το μηδέν.",
            "state" : "translated"
          }
        },
        "gu" : {
          "stringUnit" : {
            "value" : "વિશિષ્ટ લેબલ્સ, નકારાત્મક મૂલ્યો અને શૂન્યથી વધુ કુલનો ઉપયોગ કરો.",
            "state" : "translated"
          }
        },
        "cs" : {
          "stringUnit" : {
            "value" : "Používejte odlišné štítky, kladné hodnoty a celkovou hodnotu nad nula.",
            "state" : "translated"
          }
        },
        "ur" : {
          "stringUnit" : {
            "value" : "مختلف لیبلز، غیر منفی قیمتیں اور صفر سے اوپر کا مجموعہ استعمال کریں۔",
            "state" : "translated"
          }
        },
        "ar" : {
          "stringUnit" : {
            "value" : "استخدم تسميات مميزة، قيم غير سالبة وإجمالي أعلى من الصفر.",
            "state" : "translated"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "value" : "使用不同的標籤、非負值和總數大於零。",
            "state" : "translated"
          }
        },
        "tr" : {
          "stringUnit" : {
            "value" : "Ayrı etiketler, sıfırdan büyük toplamlar ve negatif olmayan değerler kullanın.",
            "state" : "translated"
          }
        },
        "ca" : {
          "stringUnit" : {
            "value" : "Utilitza etiquetes distintes, valors no negatius i un total superior a zero.",
            "state" : "translated"
          }
        },
        "da" : {
          "stringUnit" : {
            "value" : "Brug distinkte etiketter, ikke-negative værdier og et total over nul.",
            "state" : "translated"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "value" : "使用不同的标签、非负值和总数大于零。",
            "state" : "translated"
          }
        },
        "ko" : {
          "stringUnit" : {
            "value" : "구별되는 레이블, 비음수 값 및 0보다 큰 총계를 사용하세요.",
            "state" : "translated"
          }
        },
        "or" : {
          "stringUnit" : {
            "value" : "विशिष्ट लेबल, नकारात्मक मान और शून्य से ऊपर का कुल उपयोग करें।",
            "state" : "translated"
          }
        },
        "nb" : {
          "stringUnit" : {
            "value" : "Bruk distinkte etiketter, ikke-negative verdier og en total over null.",
            "state" : "translated"
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "value" : "Use distinct labels, nonnegative values and a total above zero.",
            "state" : "translated"
          }
        },
        "ta" : {
          "stringUnit" : {
            "value" : "विशिष्ट लेबल, गैर-नकारात्मक मान और शून्य से ऊपर का कुल उपयोग करें।",
            "state" : "translated"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "value" : "Usa etiquetas distintas, valores no negativos y un total superior a cero.",
            "state" : "translated"
          }
        },
        "th" : {
          "stringUnit" : {
            "value" : "ใช้ป้ายชื่อที่แตกต่าง ค่าที่ไม่เป็นลบ และรวมทั้งหมดที่มากกว่าศูนย์.",
            "state" : "translated"
          }
        },
        "ru" : {
          "stringUnit" : {
            "value" : "Используйте разные метки, неотрицательные значения и общую сумму выше нуля.",
