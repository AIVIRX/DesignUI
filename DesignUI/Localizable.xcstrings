    "Dock UI uses Sign in with Apple. Your email address is never shared without your permission." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock UI verwendet Anmelden mit Apple. Ihre E-Mail-Adresse wird niemals ohne Ihre Erlaubnis geteilt."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock UI使用Apple登录。您的电子邮件地址在未获得您许可的情况下不会被共享。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಡಾಕ್ ಯುಐ ಆಪಲ್‌ನೊಂದಿಗೆ ಸೈನ್ ಇನ್ ಅನ್ನು ಬಳಸುತ್ತದೆ. ನಿಮ್ಮ ಇಮೇಲ್ ವಿಳಾಸವು ನಿಮ್ಮ ಅನುಮತಿ ಇಲ್ಲದೆ ಹಂಚಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock UI ใช้การลงชื่อเข้าใช้ด้วย Apple ที่อยู่อีเมลของคุณจะไม่ถูกแชร์โดยไม่ได้รับอนุญาตจากคุณ"
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock UI utiliza Iniciar sesión con Apple. Tu dirección de correo electrónico nunca se comparte sin tu permiso."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock UI uses Sign in with Apple. Your email address is never shared without your permission."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock UI utilise Se connecter avec Apple. Votre adresse e-mail n'est jamais partagée sans votre permission."
          }
        },
        "lt" : {
          "stringUnit" : {
            "value" : "Dock UI naudoja prisijungimą su Apple. Jūsų el. pašto adresas niekada nėra dalijamasi be jūsų leidimo.",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock UI utilizza Accedi con Apple. Il tuo indirizzo email non viene mai condiviso senza il tuo permesso."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Dock UI az Apple azonosítójával való bejelentkezést használja. Az e-mail címed soha nem kerül megosztásra a hozzájárulásod nélkül."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock UI utilitza Iniciar sessió amb Apple. La teva adreça de correu electrònic mai es comparteix sense el teu permís."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock UI gebruikt Aanmelden met Apple. Je e-mailadres wordt nooit gedeeld zonder jouw toestemming."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডক ইউআই অ্যাপল দিয়ে সাইন ইন ব্যবহার করে। আপনার ইমেল ঠিকানা কখনও আপনার অনুমতি ছাড়া শেয়ার করা হয় না।"
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock UI એ Apple સાથે સાઇન ઇનનો ઉપયોગ કરે છે. તમારો ઇમેઇલ સરનામું તમારી મંજૂરી વિના ક્યારેય શેર કરવામાં આવતું નથી."
          }
        },
        "ms" : {
          "stringUnit" : {
            "value" : "Dock UI menggunakan Daftar Masuk dengan Apple. Alamat emel anda tidak akan dikongsi tanpa kebenaran anda.",
            "state" : "translated"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدم واجهة Dock تسجيل الدخول باستخدام Apple. عنوان بريدك الإلكتروني لا يتم مشاركته أبداً دون إذنك."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock UI 使用 Apple 登入。您的電子郵件地址在未經您允許的情況下不會被分享。"
          }
        },
